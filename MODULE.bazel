# go rules
bazel_dep(name = "rules_go", version = "0.63.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

bazel_dep(name = "gazelle", version = "0.51.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_google_wire")

# protobuf
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "grpc_ecosystem_grpc_gateway", version = "2.29.0.bcr.3")

# ios rules
bazel_dep(name = "apple_support", version = "2.8.2")
bazel_dep(name = "rules_apple", version = "5.0.0-rc4")
bazel_dep(name = "rules_swift", version = "4.0.0-rc6")
bazel_dep(name = "rules_xcodeproj", version = "4.1.0")

# terraform rules
bazel_dep(name = "rules_terraform", version = "0.0.2")

# shell rules
bazel_dep(name = "rules_shell", version = "0.8.0")
